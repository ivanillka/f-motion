{
  "alias": ["/api", "/v1"],
  "auth": ["supabase_jwt", "api_key_fm"],
  "routes": [
    { "method": "GET", "path": "/v1/me/usage", "auth": true },
    { "method": "GET", "path": "/v1/me/api-keys", "auth": true },
    { "method": "POST", "path": "/v1/me/api-keys", "auth": true },
    { "method": "DELETE", "path": "/v1/me/api-keys/{key_id}", "auth": true },
    { "method": "GET", "path": "/v1/projects", "auth": true },
    { "method": "POST", "path": "/v1/projects", "auth": true },
    { "method": "GET", "path": "/v1/projects/{project_id}", "auth": true },
    { "method": "POST", "path": "/v1/projects/{project_id}/commands", "auth": true },
    { "method": "POST", "path": "/v1/projects/{project_id}/media/uploads", "auth": true },
    { "method": "POST", "path": "/v1/projects/{project_id}/media/{asset_id}/complete", "auth": true },
    { "method": "GET", "path": "/v1/projects/{project_id}/media/{asset_id}", "auth": true },
    { "method": "GET", "path": "/v1/pexels/search", "auth": true },
    { "method": "POST", "path": "/v1/projects/{project_id}/media/pexels", "auth": true },
    { "method": "POST", "path": "/v1/projects/{project_id}/media/pexels/auto", "auth": true },
    { "method": "POST", "path": "/v1/projects/{project_id}/render", "auth": true, "errors": ["quota_exceeded", "render_capacity"] },
    { "method": "POST", "path": "/v1/render-jobs/{job_id}/cancel", "auth": true },
    { "method": "GET", "path": "/v1/render-jobs/{job_id}/events", "auth": true },
    { "method": "GET", "path": "/v1/render-jobs/{job_id}/download", "auth": true },
    { "method": "GET", "path": "/v1/download/{job_id}", "auth": true },
    { "method": "GET", "path": "/v1/providers/fal/credential", "auth": true },
    { "method": "PUT", "path": "/v1/providers/fal/credential", "auth": true },
    { "method": "POST", "path": "/v1/providers/fal/credential/test", "auth": true },
    { "method": "DELETE", "path": "/v1/providers/fal/credential", "auth": true },
    { "method": "GET", "path": "/v1/providers/pexels/credential", "auth": true },
    { "method": "PUT", "path": "/v1/providers/pexels/credential", "auth": true },
    { "method": "POST", "path": "/v1/providers/pexels/credential/test", "auth": true },
    { "method": "DELETE", "path": "/v1/providers/pexels/credential", "auth": true },
    { "method": "POST", "path": "/v1/integrations/project-imports", "auth": "integration_token" }
  ]
}
