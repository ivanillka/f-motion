{
  "name": "f-engine",
  "private": true,
  "version": "0.3.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/f-motion.git"
  },
  "engines": { "node": "24.15.0", "npm": "11.12.1" },
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/worker",
    "packages/contracts",
    "packages/fal-host",
    "packages/reel-engine",
    "packages/fmotion-cli",
    "packages/fmotion-mcp"
  ],
  "scripts": {
    "lint": "tsc -b --pretty false",
    "test": "node --test prisma/*.test.mjs tests/agents/skill-sources.test.mjs deploy/vps/*.test.mjs deploy/hetzner/*.test.mjs && npm test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:pages": "VITE_SITE_AT_ROOT=1 npm run build --workspace apps/web && npm run verify:pages-artifact",
    "verify:pages-artifact": "node tools/deploy/verify-pages-artifact.mjs",
    "deploy:pages": "node tools/deploy/deploy-pages.mjs",
    "smoke:pages": "node tools/deploy/smoke-pages.mjs",
    "smoke:agents": "node tests/agents/smoke.mjs",
    "demo": "npm run build --workspace apps/api && npm run build --workspace apps/worker && node tests/e2e/run-servers.mjs",
    "stack": "npm run build --workspace apps/api && npm run start --workspace apps/api",
    "test:e2e:web": "playwright test -c tests/e2e/playwright.config.ts",
    "test:package-consumer": "node --test tests/package-consumer.test.mjs",
    "linkedin:n8n:setup": "node scripts/setup-n8n-fmotion-linkedin.mjs",
    "vps:up": "bash scripts/vps-up.sh",
    "hetzner:up": "bash scripts/hetzner-up.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "prisma": "6.12.0",
    "typescript": "5.8.3"
  }
}
