<mxfile host="app.diagrams.net" modified="2026-07-25T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="product-flow" name="1. Product &amp; User Flow">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="pf-0"/>
        <mxCell id="pf-1" parent="pf-0"/>
        <mxCell id="pf-title" value="F-Motion — Product &amp; User Flow (f-motion.com · v1)" style="text;html=1;fontSize=24;fontStyle=1;align=center;" vertex="1" parent="pf-1"><mxGeometry x="430" y="20" width="740" height="40" as="geometry"/></mxCell>
        <mxCell id="pf-subtitle" value="Standalone product · Web, Android, iOS, Linux · Download-only launch" style="text;html=1;fontSize=13;fontColor=#666666;align=center;" vertex="1" parent="pf-1"><mxGeometry x="480" y="60" width="640" height="30" as="geometry"/></mxCell>

        <mxCell id="pf-entry" value="&lt;b&gt;First launch / Sign in&lt;/b&gt;&lt;br&gt;Standalone F-Motion account" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="pf-1"><mxGeometry x="50" y="145" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="pf-onboard" value="&lt;b&gt;Provider onboarding&lt;/b&gt;&lt;br&gt;Pexels requires the user's API key&lt;br&gt;FAL requires the user's API-scope key&lt;br&gt;No platform provider keys or credits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="pf-1"><mxGeometry x="320" y="130" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="pf-test" value="&lt;b&gt;Generation readiness&lt;/b&gt;&lt;br&gt;Personal FAL key connected and valid?&lt;br&gt;Otherwise generation is unavailable" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="pf-1"><mxGeometry x="600" y="130" width="190" height="100" as="geometry"/></mxCell>
        <mxCell id="pf-chat" value="&lt;b&gt;Chat-style brief&lt;/b&gt;&lt;br&gt;Goal · topic · audience · tone&lt;br&gt;User media upload · references" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="pf-1"><mxGeometry x="850" y="135" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="pf-options" value="&lt;b&gt;Generate several concepts&lt;/b&gt;&lt;br&gt;Hook · storyboard · media direction&lt;br&gt;Duration + aspect-ratio fit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="pf-1"><mxGeometry x="1150" y="135" width="240" height="90" as="geometry"/></mxCell>

        <mxCell id="pf-format" value="&lt;b&gt;Choose one output&lt;/b&gt;&lt;br&gt;YouTube video 16:9&lt;br&gt;Reel / Short 9:16&lt;br&gt;Story 9:16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="pf-1"><mxGeometry x="1150" y="320" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="pf-generate" value="&lt;b&gt;Generation job&lt;/b&gt;&lt;br&gt;Script → assets → timeline → render&lt;br&gt;Progress survives app close" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="pf-1"><mxGeometry x="850" y="325" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="pf-preview" value="&lt;b&gt;Preview only&lt;/b&gt;&lt;br&gt;Fast proxy / low-resolution render&lt;br&gt;Review before final export" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="pf-1"><mxGeometry x="580" y="325" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="pf-decision" value="Download or edit?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="pf-1"><mxGeometry x="330" y="320" width="190" height="100" as="geometry"/></mxCell>
        <mxCell id="pf-edit" value="&lt;b&gt;Guided storyboard editor&lt;/b&gt;&lt;br&gt;Scene cards · preview · inspector&lt;br&gt;Confirmed chat edits · lock scenes&lt;br&gt;Instant preview + accurate re-preview" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="pf-1"><mxGeometry x="50" y="320" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="pf-export" value="&lt;b&gt;Final render &amp; download&lt;/b&gt;&lt;br&gt;Export chosen format to device&lt;br&gt;No social publishing in v1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="pf-1"><mxGeometry x="330" y="500" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="pf-drafts" value="&lt;b&gt;Draft library (always saved)&lt;/b&gt;&lt;br&gt;Brief + selected concept + timeline + assets + render state&lt;br&gt;Resume editing from any supported device" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="pf-1"><mxGeometry x="690" y="500" width="350" height="90" as="geometry"/></mxCell>

        <mxCell id="pf-settings" value="&lt;b&gt;Provider settings&lt;/b&gt;&lt;br&gt;Pexels: included by F-Motion&lt;br&gt;FAL: personal key only, charged directly&lt;br&gt;Connect · test · replace · disconnect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="pf-1"><mxGeometry x="50" y="665" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="pf-states" value="&lt;b&gt;Project states&lt;/b&gt;&lt;br&gt;Draft → Generating → Preview ready → Editing → Exporting → Export ready&lt;br&gt;Failure returns to a recoverable draft; retry only the failed stage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="pf-1"><mxGeometry x="330" y="665" width="500" height="100" as="geometry"/></mxCell>
        <mxCell id="pf-blockers" value="&lt;b&gt;Launch gates still open&lt;/b&gt;&lt;br&gt;• Legal/accounting review before accepting payments&lt;br&gt;• Copyright/takedown policy review before public uploads&lt;br&gt;• Privacy/retention policy review before public accounts&lt;br&gt;• Product copy, accessibility and real-device usability validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="pf-1"><mxGeometry x="890" y="650" width="500" height="130" as="geometry"/></mxCell>

        <mxCell id="pf-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pf-1" source="pf-entry" target="pf-onboard"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pf-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pf-1" source="pf-onboard" target="pf-test"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pf-e3" value="Ready" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pf-1" source="pf-test" target="pf-chat"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pf-e4" value="Fix connection" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="pf-1" source="pf-test" target="pf-settings"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pf-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pf-1" source="pf-chat" target="pf-options"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pf-e6" value="User selects one" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pf-1" source="pf-options" target="pf-format"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pf-e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pf-1" source="pf-format" target="pf-generate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pf-e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pf-1" source="pf-generate" target="pf-preview"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pf-e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pf-1" source="pf-preview" target="pf-decision"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pf-e10" value="Edit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pf-1" source="pf-decision" target="pf-edit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pf-e11" value="Re-preview" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pf-1" source="pf-edit" target="pf-preview"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="270"/><mxPoint x="690" y="270"/></Array></mxGeometry></mxCell>
        <mxCell id="pf-e12" value="Download" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pf-1" source="pf-decision" target="pf-export"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pf-e13" value="Autosave each meaningful change" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="pf-1" source="pf-edit" target="pf-drafts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pf-e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="pf-1" source="pf-generate" target="pf-drafts"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="technical-architecture" name="2. Technical Architecture">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="ta-0"/>
        <mxCell id="ta-1" parent="ta-0"/>
        <mxCell id="ta-title" value="Standalone F-Motion — Gated v1 Technical Architecture" style="text;html=1;fontSize=24;fontStyle=1;align=center;" vertex="1" parent="ta-1"><mxGeometry x="350" y="20" width="900" height="40" as="geometry"/></mxCell>

        <mxCell id="ta-clients" value="&lt;b&gt;Split standalone clients&lt;/b&gt;&lt;br&gt;Web client — React + TypeScript · Android client — Flutter&lt;br&gt;Framework-owned local media/cache adapters · iOS: later Flutter/platform gate · Linux: client choice reopened&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;No provider secrets stored in app bundle&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="ta-1"><mxGeometry x="480" y="90" width="640" height="100" as="geometry"/></mxCell>

        <mxCell id="ta-api" value="&lt;b&gt;Express API / BFF — Node.js + TypeScript&lt;/b&gt;&lt;br&gt;One shared versioned HTTP/SSE contract for React web and Flutter Android&lt;br&gt;Independently deployed/persistent · signed R2 URLs · jobs · live progress&lt;br&gt;&lt;i&gt;ponytail: reuse Express/Prisma conventions; a separate repo is not a reason for a second backend framework.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="ta-1"><mxGeometry x="480" y="235" width="640" height="115" as="geometry"/></mxCell>
        <mxCell id="ta-auth" value="&lt;b&gt;Supabase Auth&lt;/b&gt;&lt;br&gt;Independent accounts&lt;br&gt;JWT + framework-native adapters&lt;br&gt;secure platform token storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="ta-1"><mxGeometry x="80" y="250" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="ta-secrets" value="&lt;b&gt;Application credential vault&lt;/b&gt;&lt;br&gt;User Pexels + FAL keys&lt;br&gt;no shared provider credential or fallback&lt;br&gt;AES-256-GCM · mask · rotate · audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="ta-1"><mxGeometry x="1260" y="245" width="250" height="100" as="geometry"/></mxCell>

        <mxCell id="ta-orch" value="&lt;b&gt;Established PostgreSQL queue library — selection gate&lt;/b&gt;&lt;br&gt;Do not hand-roll leasing, retries, heartbeats or cancellation&lt;br&gt;Spike: Supabase connection mode · transactional enqueue · lease recovery · idempotent keys · cancellation · metrics · maintained TypeScript support" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="ta-1"><mxGeometry x="480" y="390" width="640" height="110" as="geometry"/></mxCell>
        <mxCell id="ta-workers" value="&lt;b&gt;Fly.io Docker media workers&lt;/b&gt;&lt;br&gt;Node.js + TypeScript · independently sized/scaled · ephemeral temp files&lt;br&gt;Asset pipeline · timeline assembly · preview/final FFmpeg render" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="ta-1"><mxGeometry x="480" y="550" width="640" height="90" as="geometry"/></mxCell>

        <mxCell id="ta-db" value="&lt;b&gt;Supabase PostgreSQL + Prisma&lt;/b&gt;&lt;br&gt;Users · projects · draft revisions&lt;br&gt;timeline JSON · durable jobs&lt;br&gt;integration metadata only" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="ta-1"><mxGeometry x="90" y="530" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="ta-storage" value="&lt;b&gt;Private Cloudflare R2&lt;/b&gt;&lt;br&gt;S3-compatible uploads · assets · previews · exports&lt;br&gt;Short-lived signed URLs · lifecycle/retention rules&lt;br&gt;No durable media on Fly disks" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="ta-1"><mxGeometry x="1240" y="530" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="ta-pexels" value="&lt;b&gt;Pexels API&lt;/b&gt;&lt;br&gt;Stock photos/video&lt;br&gt;Attribution/license metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="ta-1"><mxGeometry x="1200" y="400" width="180" height="85" as="geometry"/></mxCell>
        <mxCell id="ta-fal" value="&lt;b&gt;FAL API&lt;/b&gt;&lt;br&gt;AI visual media&lt;br&gt;Beatoven blocked pending provider agreement&lt;br&gt;Async callbacks/polling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="ta-1"><mxGeometry x="1385" y="390" width="175" height="105" as="geometry"/></mxCell>

        <mxCell id="ta-engine" value="&lt;b&gt;Shared Reel Engine — server/worker-only private TypeScript&lt;/b&gt;&lt;br&gt;Canonical project/timeline schema · validation · concept contracts&lt;br&gt;provider interfaces · edit operations · render-plan generation&lt;br&gt;&lt;i&gt;Pure core where possible; host apps own auth, persistence, queues and UI&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="ta-1"><mxGeometry x="400" y="720" width="800" height="110" as="geometry"/></mxCell>
        <mxCell id="ta-registry" value="&lt;b&gt;Standalone repo / packages/reel-engine&lt;/b&gt;&lt;br&gt;Private TypeScript package boundary with self-checks&lt;br&gt;Not published while there is one consumer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="ta-1"><mxGeometry x="620" y="875" width="360" height="100" as="geometry"/></mxCell>
        <mxCell id="ta-fotium" value="&lt;b&gt;Fotium integration — later consumer #2&lt;/b&gt;&lt;br&gt;Fotium keeps its own UI, auth, backend and database&lt;br&gt;Publication begins only when integration work starts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="ta-1"><mxGeometry x="90" y="875" width="350" height="100" as="geometry"/></mxCell>
        <mxCell id="ta-standrepo" value="&lt;b&gt;Standalone private repo&lt;/b&gt;&lt;br&gt;React web + Flutter Android + Express API + Fly.io worker/Docker config&lt;br&gt;Own database/accounts; deploys independently" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="ta-1"><mxGeometry x="1160" y="875" width="350" height="100" as="geometry"/></mxCell>

        <mxCell id="ta-note" value="&lt;b&gt;Boundary rule&lt;/b&gt;&lt;br&gt;Share domain behavior and contracts—not databases, accounts, UI, deployment, or user credentials. This prevents either product from blocking the other while keeping reel behavior aligned." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="ta-1"><mxGeometry x="40" y="710" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="ta-risks" value="&lt;b&gt;Remaining launch gates&lt;/b&gt;&lt;br&gt;• Legal/accounting review before payments go live&lt;br&gt;• Copyright/takedown policy review before public uploads&lt;br&gt;• Privacy/retention policy review before public accounts&lt;br&gt;• Accessibility + real-device performance/usability validation&lt;br&gt;&lt;i&gt;Approved: responsive guided storyboard editor&lt;/i&gt;&lt;br&gt;&lt;i&gt;Approved: 2/10 GB quota + trash/deletion recovery&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="ta-1"><mxGeometry x="1240" y="680" width="320" height="180" as="geometry"/></mxCell>

        <mxCell id="ta-e1" value="versioned HTTP/SSE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="ta-1" source="ta-clients" target="ta-api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ta-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="ta-1" source="ta-auth" target="ta-api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ta-e3" value="Server-side only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="ta-1" source="ta-api" target="ta-secrets"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ta-e4" value="enqueue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="ta-1" source="ta-api" target="ta-orch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ta-e5" value="lease stages" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="ta-1" source="ta-orch" target="ta-workers"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ta-e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="ta-1" source="ta-api" target="ta-db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ta-e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="ta-1" source="ta-workers" target="ta-storage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ta-e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="ta-1" source="ta-workers" target="ta-pexels"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ta-e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="ta-1" source="ta-workers" target="ta-fal"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ta-e10" value="domain calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="ta-1" source="ta-workers" target="ta-engine"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ta-e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="ta-1" source="ta-engine" target="ta-registry"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ta-e12" value="pinned version" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="ta-1" source="ta-registry" target="ta-fotium"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ta-e13" value="pinned version" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="ta-1" source="ta-registry" target="ta-standrepo"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="engine-boundary" name="3. Shared Reel Engine Boundary">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="eb-0"/>
        <mxCell id="eb-1" parent="eb-0"/>
        <mxCell id="eb-title" value="Shared Reel Engine — TypeScript Package Boundary (Approved)" style="text;html=1;fontSize=24;fontStyle=1;align=center;" vertex="1" parent="eb-1"><mxGeometry x="380" y="20" width="840" height="40" as="geometry"/></mxCell>
        <mxCell id="eb-rule" value="&lt;b&gt;Core rule:&lt;/b&gt; deterministic reel-domain behavior belongs in the package; accounts, secrets, persistence, infrastructure and provider SDKs belong to each host." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;" vertex="1" parent="eb-1"><mxGeometry x="250" y="75" width="1100" height="55" as="geometry"/></mxCell>

        <mxCell id="eb-host-fotium" value="&lt;b&gt;Fotium backend&lt;/b&gt;&lt;br&gt;Existing TypeScript host&lt;br&gt;Pins an engine version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="eb-1"><mxGeometry x="70" y="180" width="250" height="85" as="geometry"/></mxCell>
        <mxCell id="eb-host-standalone" value="&lt;b&gt;Standalone Express backend&lt;/b&gt;&lt;br&gt;Node.js + TypeScript on Fly.io&lt;br&gt;Consumes local packages/reel-engine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="eb-1"><mxGeometry x="1280" y="180" width="250" height="85" as="geometry"/></mxCell>
        <mxCell id="eb-contracts" value="&lt;b&gt;Public contracts&lt;/b&gt;&lt;br&gt;Versioned TypeScript types + JSON Schema/OpenAPI&lt;br&gt;Project · brief · concept · timeline · render plan · edit command&lt;br&gt;Generated Dart request/response models for Flutter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="eb-1"><mxGeometry x="430" y="165" width="740" height="115" as="geometry"/></mxCell>

        <mxCell id="eb-model" value="&lt;b&gt;Domain model&lt;/b&gt;&lt;br&gt;Canonical project/timeline schema&lt;br&gt;Format + aspect-ratio rules&lt;br&gt;State transitions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="eb-1"><mxGeometry x="160" y="360" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="eb-validation" value="&lt;b&gt;Validation&lt;/b&gt;&lt;br&gt;Trust-boundary input checks&lt;br&gt;Timeline invariants&lt;br&gt;Actionable domain errors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="eb-1"><mxGeometry x="430" y="360" width="230" height="105" as="geometry"/></mxCell>
        <mxCell id="eb-concepts" value="&lt;b&gt;Concept planning&lt;/b&gt;&lt;br&gt;Brief → concept contracts&lt;br&gt;Hook/storyboard structure&lt;br&gt;Selection normalization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="eb-1"><mxGeometry x="680" y="360" width="240" height="105" as="geometry"/></mxCell>
        <mxCell id="eb-edits" value="&lt;b&gt;Edit operations&lt;/b&gt;&lt;br&gt;Replace · trim · reorder&lt;br&gt;Text/timing/crop changes&lt;br&gt;Immutable revision output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="eb-1"><mxGeometry x="940" y="360" width="230" height="105" as="geometry"/></mxCell>
        <mxCell id="eb-render" value="&lt;b&gt;Render planning&lt;/b&gt;&lt;br&gt;Timeline → renderer-neutral plan&lt;br&gt;Preview/final profiles&lt;br&gt;No FFmpeg process execution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="eb-1"><mxGeometry x="1190" y="360" width="250" height="105" as="geometry"/></mxCell>

        <mxCell id="eb-ports" value="&lt;b&gt;Provider ports (interfaces only)&lt;/b&gt;&lt;br&gt;StockMediaProvider · GenerativeMediaProvider · TextModelProvider&lt;br&gt;AssetStore · Renderer · Clock / ID source&lt;br&gt;Engine depends on these interfaces; host adapters implement them." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="eb-1"><mxGeometry x="350" y="525" width="900" height="110" as="geometry"/></mxCell>

        <mxCell id="eb-out-title" value="HOST-OWNED — OUTSIDE THE ENGINE" style="text;html=1;fontSize=16;fontStyle=1;align=center;fontColor=#b85450;" vertex="1" parent="eb-1"><mxGeometry x="550" y="685" width="500" height="30" as="geometry"/></mxCell>
        <mxCell id="eb-out-auth" value="&lt;b&gt;Identity &amp; access&lt;/b&gt;&lt;br&gt;Accounts · sessions · authorization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="eb-1"><mxGeometry x="60" y="745" width="220" height="75" as="geometry"/></mxCell>
        <mxCell id="eb-out-secret" value="&lt;b&gt;Secrets&lt;/b&gt;&lt;br&gt;AES-256-GCM via Node crypto&lt;br&gt;versioned key · revoke · audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="eb-1"><mxGeometry x="300" y="745" width="220" height="75" as="geometry"/></mxCell>
        <mxCell id="eb-out-data" value="&lt;b&gt;Persistence&lt;/b&gt;&lt;br&gt;Database · drafts · revisions&lt;br&gt;object storage · retention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="eb-1"><mxGeometry x="540" y="745" width="220" height="75" as="geometry"/></mxCell>
        <mxCell id="eb-out-jobs" value="&lt;b&gt;Execution&lt;/b&gt;&lt;br&gt;Queues · retries · callbacks&lt;br&gt;progress · cancellation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="eb-1"><mxGeometry x="780" y="745" width="220" height="75" as="geometry"/></mxCell>
        <mxCell id="eb-out-adapters" value="&lt;b&gt;Provider adapters&lt;/b&gt;&lt;br&gt;Pexels/FAL SDK + HTTP&lt;br&gt;rate limits · provider errors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="eb-1"><mxGeometry x="1020" y="745" width="220" height="75" as="geometry"/></mxCell>
        <mxCell id="eb-out-renderer" value="&lt;b&gt;Media runtime&lt;/b&gt;&lt;br&gt;FFmpeg · temp files · compute&lt;br&gt;downloads · signed URLs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="eb-1"><mxGeometry x="1260" y="745" width="220" height="75" as="geometry"/></mxCell>

        <mxCell id="eb-release" value="&lt;b&gt;Standalone repo / packages/reel-engine&lt;/b&gt;&lt;br&gt;Private TypeScript package boundary with self-checks · Not published while there is one consumer&lt;br&gt;&lt;b&gt;When Fotium integration starts:&lt;/b&gt; 1. confirm two real consumers; 2. add SemVer automation/private registry; 3. pin versions independently; 4. add compatibility and draft-migration tests before the first shared release.&lt;br&gt;&lt;i&gt;ponytail: package boundary now, distribution system at consumer #2.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="eb-1"><mxGeometry x="200" y="865" width="1200" height="125" as="geometry"/></mxCell>
        <mxCell id="eb-flutter" value="&lt;b&gt;Flutter boundary&lt;/b&gt;&lt;br&gt;Flutter consumes generated contracts through the standalone API. It never imports the TypeScript engine, provider SDKs, or rendering logic." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="eb-1"><mxGeometry x="420" y="1010" width="760" height="65" as="geometry"/></mxCell>

        <mxCell id="eb-e1" value="imports package" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="eb-1" source="eb-host-fotium" target="eb-contracts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb-e2" value="imports package" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="eb-1" source="eb-host-standalone" target="eb-contracts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="eb-1" source="eb-contracts" target="eb-model"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="eb-1" source="eb-contracts" target="eb-validation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="eb-1" source="eb-contracts" target="eb-concepts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb-e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="eb-1" source="eb-contracts" target="eb-edits"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb-e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="eb-1" source="eb-contracts" target="eb-render"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb-e8" value="depends inward" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="eb-1" source="eb-ports" target="eb-contracts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb-e9" value="implements ports" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="eb-1" source="eb-out-adapters" target="eb-ports"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb-e10" value="implements Renderer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="eb-1" source="eb-out-renderer" target="eb-ports"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="capacity-retention" name="4. Media Limits &amp; Retention">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="cr-0"/>
        <mxCell id="cr-1" parent="cr-0"/>
        <mxCell id="cr-title" value="Media Limits, Capacity &amp; Retention — Launch defaults, configurable" style="text;html=1;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="cr-1"><mxGeometry x="300" y="20" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="cr-principle" value="Launch constraint: predictable rendering and storage first. Limits are policy/configuration—not hard-coded Reel Engine behavior." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;" vertex="1" parent="cr-1"><mxGeometry x="320" y="80" width="960" height="55" as="geometry"/></mxCell>

        <mxCell id="cr-youtube" value="&lt;b&gt;YouTube video&lt;/b&gt;&lt;br&gt;Launch default — configurable&lt;br&gt;3 min · 1920×1080 · 16:9 · 30 FPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="cr-1"><mxGeometry x="120" y="190" width="300" height="115" as="geometry"/></mxCell>
        <mxCell id="cr-reel" value="&lt;b&gt;Reel / Short&lt;/b&gt;&lt;br&gt;Launch default — configurable&lt;br&gt;90 sec · 1080×1920 · 9:16 · 30 FPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="cr-1"><mxGeometry x="650" y="190" width="300" height="115" as="geometry"/></mxCell>
        <mxCell id="cr-story" value="&lt;b&gt;Story&lt;/b&gt;&lt;br&gt;Launch default — configurable&lt;br&gt;60 sec · 1080×1920 · 9:16 · 30 FPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="cr-1"><mxGeometry x="1180" y="190" width="300" height="115" as="geometry"/></mxCell>

        <mxCell id="cr-upload" value="&lt;b&gt;Upload admission&lt;/b&gt;&lt;br&gt;Launch default — configurable: 500 MB/source&lt;br&gt;Validate declared type + detected media&lt;br&gt;Direct-to-R2 signed upload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="cr-1"><mxGeometry x="100" y="395" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="cr-preview" value="&lt;b&gt;Preview render&lt;/b&gt;&lt;br&gt;Launch default — configurable: 720p, watermark&lt;br&gt;Fast review proxy; retained 7 days" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="cr-1"><mxGeometry x="470" y="395" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="cr-final" value="&lt;b&gt;Final render&lt;/b&gt;&lt;br&gt;Launch default — configurable: 1080p, 30 FPS&lt;br&gt;Short-lived signed URL; retained 30 days" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="cr-1"><mxGeometry x="840" y="395" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="cr-draft" value="&lt;b&gt;Draft durability&lt;/b&gt;&lt;br&gt;Source retained until explicit deletion&lt;br&gt;Launch default — configurable: 2/10 GB, 50 revisions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="cr-1"><mxGeometry x="1210" y="395" width="300" height="110" as="geometry"/></mxCell>

        <mxCell id="cr-request" value="Render requested" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="cr-1"><mxGeometry x="90" y="620" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="cr-userlimit" value="&lt;b&gt;Per-user admission check&lt;/b&gt;&lt;br&gt;Launch default — configurable&lt;br&gt;1 active + maximum 2 queued" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="cr-1"><mxGeometry x="340" y="590" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="cr-queue" value="&lt;b&gt;PostgreSQL job queue&lt;/b&gt;&lt;br&gt;Fair ordering · idempotent lease&lt;br&gt;retry/backoff · cancellation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="cr-1"><mxGeometry x="670" y="605" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="cr-workers" value="&lt;b&gt;Initial worker pool&lt;/b&gt;&lt;br&gt;Launch default — configurable: 2 concurrent FFmpeg workers&lt;br&gt;Scale from measured queue depth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="cr-1"><mxGeometry x="1020" y="600" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="cr-r2" value="&lt;b&gt;Private R2&lt;/b&gt;&lt;br&gt;Preview / final object&lt;br&gt;+ retention expiry metadata" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="cr-1"><mxGeometry x="1390" y="595" width="170" height="110" as="geometry"/></mxCell>

        <mxCell id="cr-expiry" value="&lt;b&gt;Cleanup + project-owned storage&lt;/b&gt;&lt;br&gt;Canonical prefix: users/{userId}/projects/{projectId}/... · format duplication copies the required media into the new prefix and charges quota again. Project purge deletes only its prefix after trash; account purge deletes the account prefix. Pexels search cache remains outside quota.&lt;br&gt;&lt;i&gt;ponytail: duplicate bytes instead of sharing deletion lifetime. Ceiling: extra R2 storage. Upgrade path: content-addressed dedup only after measured cost exceeds the deletion-safety benefit.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="cr-1"><mxGeometry x="220" y="790" width="1160" height="130" as="geometry"/></mxCell>

        <mxCell id="cr-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="cr-1" source="cr-request" target="cr-userlimit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cr-e2" value="admitted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="cr-1" source="cr-userlimit" target="cr-queue"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cr-e3" value="lease" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="cr-1" source="cr-queue" target="cr-workers"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cr-e4" value="write result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="cr-1" source="cr-workers" target="cr-r2"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="provider-credentials" name="5. Providers &amp; Cost Controls">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="pc-0"/>
        <mxCell id="pc-1" parent="pc-0"/>
        <mxCell id="pc-title" value="Approved v1 Provider Credentials &amp; Cost Controls" style="text;html=1;fontSize=24;fontStyle=1;align=center;" vertex="1" parent="pc-1"><mxGeometry x="400" y="20" width="800" height="40" as="geometry"/></mxCell>
        <mxCell id="pc-user" value="&lt;b&gt;Creator&lt;/b&gt;&lt;br&gt;Connects a personal Pexels API key for stock&lt;br&gt;Connects a personal FAL API-scope key for generation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="pc-1"><mxGeometry x="620" y="90" width="360" height="85" as="geometry"/></mxCell>

        <mxCell id="pc-pexels-mode" value="&lt;b&gt;Pexels — BYOK only&lt;/b&gt;&lt;br&gt;One encrypted key per user&lt;br&gt;No platform credential or fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="pc-1"><mxGeometry x="130" y="245" width="420" height="100" as="geometry"/></mxCell>
        <mxCell id="pc-fal-mode" value="&lt;b&gt;FAL — BYOK only&lt;/b&gt;&lt;br&gt;Required: user-supplied API-scope key&lt;br&gt;User's FAL account is charged directly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;" vertex="1" parent="pc-1"><mxGeometry x="1050" y="245" width="420" height="100" as="geometry"/></mxCell>

        <mxCell id="pc-pexels-controls" value="&lt;b&gt;Pexels adapter controls&lt;/b&gt;&lt;br&gt;Server-side calls only · normalized 24-hour search cache&lt;br&gt;Track rate-limit headers · preserve source/photographer metadata&lt;br&gt;Prominent Pexels link + photographer attribution when possible&lt;br&gt;Request expanded limits before public launch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="pc-1"><mxGeometry x="80" y="410" width="520" height="140" as="geometry"/></mxCell>
        <mxCell id="pc-fal-router" value="&lt;b&gt;Credential gate&lt;/b&gt;&lt;br&gt;Valid owner-scoped personal key: continue&lt;br&gt;Missing or invalid key: generation unavailable&lt;br&gt;Never fall back to a platform or another user's key" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="pc-1"><mxGeometry x="700" y="400" width="260" height="160" as="geometry"/></mxCell>
        <mxCell id="pc-fal-controls" value="&lt;b&gt;BYOK FAL controls&lt;/b&gt;&lt;br&gt;Model/parameter allowlist · current price before confirmation&lt;br&gt;Owner-bound job · idempotent enqueue and callbacks&lt;br&gt;User sees provider charge in their FAL account&lt;br&gt;No F-Motion balance, markup, or platform spend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="pc-1"><mxGeometry x="1030" y="400" width="500" height="160" as="geometry"/></mxCell>

        <mxCell id="pc-vault" value="&lt;b&gt;Credential vault&lt;/b&gt;&lt;br&gt;Personal Pexels + FAL keys; no platform provider keys&lt;br&gt;AES-256-GCM with versioned master key outside database&lt;br&gt;Store owner, provider, key version and last-four metadata&lt;br&gt;Decrypt only in an owner-checked provider call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="pc-1"><mxGeometry x="100" y="650" width="440" height="145" as="geometry"/></mxCell>
        <mxCell id="pc-byok" value="&lt;b&gt;Personal FAL key lifecycle&lt;/b&gt;&lt;br&gt;Ask for API scope; FAL exposes no safe scope introspection&lt;br&gt;Validate without generation · never return the full secret&lt;br&gt;Display last four only · test · replace · disconnect&lt;br&gt;A user's key may run only that user's jobs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="pc-1"><mxGeometry x="580" y="650" width="440" height="145" as="geometry"/></mxCell>
        <mxCell id="pc-ledger" value="&lt;b&gt;Provider job audit&lt;/b&gt;&lt;br&gt;Provider request ID + project/job ownership&lt;br&gt;Idempotent job and callback records&lt;br&gt;No F-Motion FAL credit ledger or stored balance&lt;br&gt;User reviews charges in the FAL dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="pc-1"><mxGeometry x="1060" y="650" width="440" height="145" as="geometry"/></mxCell>

        <mxCell id="pc-open" value="&lt;b&gt;Pricing boundary:&lt;/b&gt; fetch the current provider estimate before explicit confirmation · the user's FAL account is charged directly · no F-Motion markup, credits, trial, or fallback account." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;" vertex="1" parent="pc-1"><mxGeometry x="270" y="870" width="1060" height="65" as="geometry"/></mxCell>

        <mxCell id="pc-e1" value="included" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pc-1" source="pc-user" target="pc-pexels-mode"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pc-e2" value="connect key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pc-1" source="pc-user" target="pc-fal-mode"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pc-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pc-1" source="pc-pexels-mode" target="pc-pexels-controls"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pc-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pc-1" source="pc-fal-mode" target="pc-fal-router"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pc-e5" value="owner key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pc-1" source="pc-fal-router" target="pc-fal-controls"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pc-e6" value="key lifecycle" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pc-1" source="pc-fal-router" target="pc-byok"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pc-e7" value="encrypted storage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="pc-1" source="pc-byok" target="pc-vault"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pc-e8" value="audit provider job" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pc-1" source="pc-fal-controls" target="pc-ledger"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pricing-credits" name="6. Pricing &amp; Credit Settlement">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="pr-0"/>
        <mxCell id="pr-1" parent="pr-0"/>
        <mxCell id="pr-title" value="Pricing, Reservation &amp; Refund Architecture — Launch defaults, configurable" style="text;html=1;fontSize=21;fontStyle=1;align=center;" vertex="1" parent="pr-1"><mxGeometry x="260" y="20" width="1080" height="40" as="geometry"/></mxCell>
        <mxCell id="pr-policy" value="&lt;b&gt;Prepaid-only launch&lt;/b&gt; · 100 Reel Credits = $1 customer value · credits remain active while the account is active · subscriptions wait for measured usage." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;" vertex="1" parent="pr-1"><mxGeometry x="250" y="80" width="1100" height="60" as="geometry"/></mxCell>

        <mxCell id="pr-trial" value="&lt;b&gt;No managed FAL trial&lt;/b&gt;&lt;br&gt;F-Motion does not fund provider calls&lt;br&gt;No platform key or spend exposure&lt;br&gt;User-owned FAL account only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="pr-1"><mxGeometry x="70" y="200" width="310" height="110" as="geometry"/></mxCell>
        <mxCell id="pr-small" value="&lt;b&gt;Small pack&lt;/b&gt;&lt;br&gt;Launch default — configurable&lt;br&gt;1,000 credits · $10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="pr-1"><mxGeometry x="450" y="200" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="pr-creator" value="&lt;b&gt;Creator pack&lt;/b&gt;&lt;br&gt;Launch default — configurable&lt;br&gt;2,500 credits · $24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="pr-1"><mxGeometry x="830" y="200" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="pr-studio" value="&lt;b&gt;Studio pack&lt;/b&gt;&lt;br&gt;Launch default — configurable&lt;br&gt;6,000 credits · $55" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="pr-1"><mxGeometry x="1210" y="200" width="300" height="110" as="geometry"/></mxCell>

        <mxCell id="pr-free" value="&lt;b&gt;Free actions&lt;/b&gt;&lt;br&gt;Pexels search · editing · autosave&lt;br&gt;Launch default — configurable: first 5 previews/draft/day" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="pr-1"><mxGeometry x="80" y="390" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="pr-preview" value="&lt;b&gt;Extra preview&lt;/b&gt;&lt;br&gt;Launch default — configurable&lt;br&gt;After allowance: 10 credits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="pr-1"><mxGeometry x="460" y="390" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="pr-export60" value="&lt;b&gt;Final export ≤ 60s&lt;/b&gt;&lt;br&gt;Generated inputs use BYOK FAL only&lt;br&gt;Export pricing is independent of provider spend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="pr-1"><mxGeometry x="800" y="390" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="pr-export90" value="&lt;b&gt;Final export ≤ 90s&lt;/b&gt;&lt;br&gt;Generated inputs use BYOK FAL only&lt;br&gt;Export pricing is independent of provider spend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="pr-1"><mxGeometry x="1140" y="390" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="pr-export180" value="&lt;b&gt;YouTube export ≤ 3m&lt;/b&gt;&lt;br&gt;Generated inputs use BYOK FAL only&lt;br&gt;Export pricing is independent of provider spend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="pr-1"><mxGeometry x="630" y="535" width="340" height="90" as="geometry"/></mxCell>

        <mxCell id="pr-confirm" value="User confirms generation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="pr-1"><mxGeometry x="60" y="710" width="190" height="65" as="geometry"/></mxCell>
        <mxCell id="pr-estimate" value="&lt;b&gt;Estimate&lt;/b&gt;&lt;br&gt;Fetch current FAL price&lt;br&gt;Show provider estimate before confirmation&lt;br&gt;No F-Motion markup or reservation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="pr-1"><mxGeometry x="310" y="690" width="240" height="105" as="geometry"/></mxCell>
        <mxCell id="pr-reserve" value="&lt;b&gt;Atomic reservation&lt;/b&gt;&lt;br&gt;Immutable ledger entry&lt;br&gt;Reject insufficient balance&lt;br&gt;never allow negative balance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="pr-1"><mxGeometry x="610" y="690" width="240" height="105" as="geometry"/></mxCell>
        <mxCell id="pr-run" value="&lt;b&gt;Run stages&lt;/b&gt;&lt;br&gt;Idempotent provider requests&lt;br&gt;record provider request IDs&lt;br&gt;track successful output only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="pr-1"><mxGeometry x="910" y="690" width="240" height="105" as="geometry"/></mxCell>
        <mxCell id="pr-settle" value="&lt;b&gt;Transactional settlement&lt;/b&gt;&lt;br&gt;Debit actual successful usage&lt;br&gt;release unused reservation&lt;br&gt;price frozen after job admission" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="pr-1"><mxGeometry x="1210" y="690" width="260" height="105" as="geometry"/></mxCell>

        <mxCell id="pr-refunds" value="&lt;b&gt;Failure handling&lt;/b&gt;&lt;br&gt;• Cancel before FAL submission: no provider call&lt;br&gt;• Multi-scene: do not submit failed or unstarted scenes&lt;br&gt;• FAL succeeds but renderer fails: retry render without repeating FAL generation&lt;br&gt;• Provider charges belong to the user's FAL account; F-Motion must explain partial success clearly&lt;br&gt;• Duplicate callbacks cannot repeat a provider request or export charge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="pr-1"><mxGeometry x="170" y="865" width="1260" height="135" as="geometry"/></mxCell>

        <mxCell id="pr-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pr-1" source="pr-confirm" target="pr-estimate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pr-e2" value="show maximum" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pr-1" source="pr-estimate" target="pr-reserve"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pr-e3" value="admitted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pr-1" source="pr-reserve" target="pr-run"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pr-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pr-1" source="pr-run" target="pr-settle"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="payments-tax" name="7. Payments, Tax &amp; Fulfillment">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="pt-0"/>
        <mxCell id="pt-1" parent="pt-0"/>
        <mxCell id="pt-title" value="Approved v1 Payments, Tax &amp; Cross-Platform Credit Fulfillment" style="text;html=1;fontSize=24;fontStyle=1;align=center;" vertex="1" parent="pt-1"><mxGeometry x="300" y="20" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="pt-rule" value="One F-Motion account and canonical credit ledger across devices. Payment providers prove purchases; they never own the spendable balance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="pt-1"><mxGeometry x="270" y="80" width="1060" height="60" as="geometry"/></mxCell>

        <mxCell id="pt-web" value="&lt;b&gt;Web + Linux&lt;/b&gt;&lt;br&gt;Paddle Checkout&lt;br&gt;One-time credit packs&lt;br&gt;Base catalog currency: USD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="pt-1"><mxGeometry x="80" y="210" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="pt-ios" value="&lt;b&gt;iOS&lt;/b&gt;&lt;br&gt;Apple consumable IAP&lt;br&gt;through RevenueCat Flutter SDK&lt;br&gt;Storefront-localized price" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="pt-1"><mxGeometry x="650" y="210" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="pt-android" value="&lt;b&gt;Android&lt;/b&gt;&lt;br&gt;Google Play consumable product&lt;br&gt;through RevenueCat Flutter SDK&lt;br&gt;Storefront-localized price" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="pt-1"><mxGeometry x="1220" y="210" width="300" height="110" as="geometry"/></mxCell>

        <mxCell id="pt-paddle" value="&lt;b&gt;Paddle — merchant of record&lt;/b&gt;&lt;br&gt;Local checkout currencies · tax/VAT/GST calculation and remittance&lt;br&gt;Compliant invoice · fraud/chargeback handling · no card data in F-Motion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="pt-1"><mxGeometry x="50" y="400" width="440" height="110" as="geometry"/></mxCell>
        <mxCell id="pt-revenuecat" value="&lt;b&gt;RevenueCat — mobile purchase adapter&lt;/b&gt;&lt;br&gt;Normalizes Apple/Google consumable purchase events&lt;br&gt;Stable F-Motion user ID · authenticated at-least-once webhooks&lt;br&gt;Does not calculate or spend the canonical Reel Credit balance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="pt-1"><mxGeometry x="580" y="400" width="440" height="110" as="geometry"/></mxCell>
        <mxCell id="pt-stores" value="&lt;b&gt;Apple / Google storefronts&lt;/b&gt;&lt;br&gt;Local pricing/payment UI and platform transaction records&lt;br&gt;Same credit-pack sizes offered in each mobile store&lt;br&gt;No prohibited external-purchase links or cheaper-price messaging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="pt-1"><mxGeometry x="1110" y="400" width="440" height="110" as="geometry"/></mxCell>

        <mxCell id="pt-gateway" value="&lt;b&gt;Verified purchase event gateway&lt;/b&gt;&lt;br&gt;Authenticate signature/authorization · reject unknown product IDs&lt;br&gt;Unique(provider, environment, transaction ID) prevents duplicate grants&lt;br&gt;Separate production and sandbox catalogs/events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;" vertex="1" parent="pt-1"><mxGeometry x="500" y="590" width="600" height="115" as="geometry"/></mxCell>
        <mxCell id="pt-map" value="&lt;b&gt;Server-owned catalog map&lt;/b&gt;&lt;br&gt;Provider product ID → 1,000 / 2,500 / 6,000 credits&lt;br&gt;Client-supplied price or credit amount is never trusted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="pt-1"><mxGeometry x="90" y="590" width="330" height="115" as="geometry"/></mxCell>
        <mxCell id="pt-ledger" value="&lt;b&gt;Canonical Reel Credit ledger&lt;/b&gt;&lt;br&gt;Transactionally insert purchase + grant entry&lt;br&gt;Cross-platform balance · trial spent first, then oldest paid credits&lt;br&gt;Credits do not expire while account remains active" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="pt-1"><mxGeometry x="1190" y="580" width="330" height="135" as="geometry"/></mxCell>

        <mxCell id="pt-refund" value="&lt;b&gt;Refund / chargeback handler&lt;/b&gt;&lt;br&gt;Idempotently reverse unused credits first · never delete drafts or media&lt;br&gt;If spent amount exceeds remaining grant: available balance stays at zero, record separate billing_debt&lt;br&gt;Pause managed generation and exports until debt is resolved; preserve a complete audit trail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="pt-1"><mxGeometry x="240" y="795" width="740" height="125" as="geometry"/></mxCell>
        <mxCell id="pt-accounting" value="&lt;b&gt;Accounting metadata&lt;/b&gt;&lt;br&gt;Provider transaction/reference · gross · tax · fee · net&lt;br&gt;purchase currency · settlement currency · exchange rate · country&lt;br&gt;&lt;i&gt;Legal/accounting review remains a launch gate.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="pt-1"><mxGeometry x="1060" y="795" width="400" height="125" as="geometry"/></mxCell>
        <mxCell id="pt-payout" value="&lt;b&gt;Payout currency&lt;/b&gt;&lt;br&gt;Match the operating bank account where possible; prefer EUR for an EUR account. This does not constrain customer checkout currencies." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="pt-1"><mxGeometry x="430" y="960" width="740" height="65" as="geometry"/></mxCell>

        <mxCell id="pt-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pt-1" source="pt-web" target="pt-paddle"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pt-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pt-1" source="pt-ios" target="pt-revenuecat"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pt-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pt-1" source="pt-android" target="pt-stores"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pt-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pt-1" source="pt-stores" target="pt-revenuecat"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pt-e5" value="webhook" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pt-1" source="pt-paddle" target="pt-gateway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pt-e6" value="webhook" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pt-1" source="pt-revenuecat" target="pt-gateway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pt-e7" value="resolve product" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pt-1" source="pt-map" target="pt-gateway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pt-e8" value="grant once" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pt-1" source="pt-gateway" target="pt-ledger"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pt-e9" value="reversal event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="pt-1" source="pt-gateway" target="pt-refund"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pt-e10" value="reverse / debt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="pt-1" source="pt-refund" target="pt-ledger"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="music-rights" name="8. Music, Uploads &amp; Rights">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="mr-0"/>
        <mxCell id="mr-1" parent="mr-0"/>
        <mxCell id="mr-title" value="Music, Audio Upload &amp; Rights Architecture — Beatoven gated" style="text;html=1;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="mr-1"><mxGeometry x="300" y="20" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="mr-rule" value="Two sources only: commercially licensed generated instrumental music, or audio the user declares they may use. No stock/trending-music integration in v1." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="mr-1"><mxGeometry x="230" y="80" width="1140" height="60" as="geometry"/></mxCell>

        <mxCell id="mr-generate" value="&lt;b&gt;Beatoven integration — blocked&lt;/b&gt;&lt;br&gt;No implementation until written terms or provider agreement confirms platform generation, end-user synchronized commercial video use, private R2 storage, final YouTube/Reel/Story delivery, dispute provenance, and acceptable prompt/content data terms.&lt;br&gt;Marketing text is not a license." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;" vertex="1" parent="mr-1"><mxGeometry x="100" y="195" width="460" height="150" as="geometry"/></mxCell>
        <mxCell id="mr-upload" value="&lt;b&gt;Upload audio&lt;/b&gt;&lt;br&gt;MP3 · WAV · M4A/AAC&lt;br&gt;Maximum 50 MB&lt;br&gt;Maximum project duration + 10 seconds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="mr-1"><mxGeometry x="1060" y="210" width="420" height="120" as="geometry"/></mxCell>

        <mxCell id="mr-generated-meta" value="&lt;b&gt;Generated-audio provenance&lt;/b&gt;&lt;br&gt;Provider/model · prompt · request ID · seed/settings&lt;br&gt;Generation timestamp · license/version reference&lt;br&gt;Keep master audio privately; export only synchronized inside video&lt;br&gt;Attribution metadata retained when required/practicable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="mr-1"><mxGeometry x="70" y="410" width="500" height="145" as="geometry"/></mxCell>
        <mxCell id="mr-declare" value="&lt;b&gt;Required rights declaration&lt;/b&gt;&lt;br&gt;“I own this audio or have permission to use, modify, synchronize, export and publish it in this project.”&lt;br&gt;Category: created · commercial license · permission · public domain/CC0 · other documented permission" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="mr-1"><mxGeometry x="1030" y="390" width="500" height="165" as="geometry"/></mxCell>
        <mxCell id="mr-validation" value="&lt;b&gt;Upload trust boundary&lt;/b&gt;&lt;br&gt;Detect actual type · probe duration/codec · reject malformed/polyglot files&lt;br&gt;Malware/media scan · cryptographic hash · private R2 quarantine first&lt;br&gt;Record user/project, declaration timestamp, original filename and optional license receipt/source URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="mr-1"><mxGeometry x="620" y="390" width="360" height="165" as="geometry"/></mxCell>

        <mxCell id="mr-editor" value="&lt;b&gt;Guided audio editor — v1&lt;/b&gt;&lt;br&gt;Generate · upload · replace · mute · volume · trim/start offset · loop · fade in/out · voiceover ducking&lt;br&gt;Preserve original master; store non-destructive timeline operations. No multitrack audio workstation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="mr-1"><mxGeometry x="300" y="640" width="1000" height="105" as="geometry"/></mxCell>

        <mxCell id="mr-manifest" value="&lt;b&gt;Per-export rights manifest&lt;/b&gt;&lt;br&gt;Pexels source/photographer credits&lt;br&gt;Generated music provider/model/license provenance&lt;br&gt;Uploaded-audio declaration reference and asset hash&lt;br&gt;Generation/export timestamps&lt;br&gt;&lt;i&gt;Evidence package, not a guarantee against platform claims&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="mr-1"><mxGeometry x="100" y="825" width="470" height="150" as="geometry"/></mxCell>
        <mxCell id="mr-license" value="&lt;b&gt;User-content license boundary&lt;/b&gt;&lt;br&gt;User retains ownership&lt;br&gt;F-Motion receives only the limited rights needed to store, process, edit, render and return the project&lt;br&gt;No redistribution and no model training rights" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="mr-1"><mxGeometry x="630" y="825" width="360" height="150" as="geometry"/></mxCell>
        <mxCell id="mr-dispute" value="&lt;b&gt;Copyright complaint / takedown flow&lt;/b&gt;&lt;br&gt;Published contact + documented review process&lt;br&gt;Quarantine disputed asset; preserve project/audit history&lt;br&gt;Disable new exports when appropriate; notify user&lt;br&gt;Never claim F-Motion verifies ownership&lt;br&gt;&lt;i&gt;Policy/legal review required before public uploads&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="mr-1"><mxGeometry x="1050" y="825" width="450" height="150" as="geometry"/></mxCell>

        <mxCell id="mr-e1" value="provenance" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="mr-1" source="mr-generate" target="mr-generated-meta"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mr-e2" value="declare" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="mr-1" source="mr-upload" target="mr-declare"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mr-e3" value="validate before use" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="mr-1" source="mr-declare" target="mr-validation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mr-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="mr-1" source="mr-generated-meta" target="mr-editor"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mr-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="mr-1" source="mr-validation" target="mr-editor"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mr-e6" value="on export" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="mr-1" source="mr-editor" target="mr-manifest"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="storage-deletion" name="9. Storage, Recovery &amp; Erasure">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="sd-0"/>
        <mxCell id="sd-1" parent="sd-0"/>
        <mxCell id="sd-title" value="Storage, Recovery &amp; Erasure — Launch defaults, configurable" style="text;html=1;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="sd-1"><mxGeometry x="310" y="20" width="980" height="40" as="geometry"/></mxCell>
        <mxCell id="sd-promise" value="Safe-mode promise: editable source media is retained within quota until explicit draft/account deletion. Inactivity alone never removes source assets." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="sd-1"><mxGeometry x="250" y="80" width="1100" height="60" as="geometry"/></mxCell>

        <mxCell id="sd-trial" value="&lt;b&gt;Trial quota&lt;/b&gt;&lt;br&gt;Launch default — configurable: 2 GB&lt;br&gt;Unlimited draft count within quota" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="sd-1"><mxGeometry x="110" y="200" width="350" height="95" as="geometry"/></mxCell>
        <mxCell id="sd-paid" value="&lt;b&gt;After first paid credit purchase&lt;/b&gt;&lt;br&gt;Launch default — configurable: 10 GB&lt;br&gt;No expiry while account remains active" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="sd-1"><mxGeometry x="625" y="200" width="350" height="95" as="geometry"/></mxCell>
        <mxCell id="sd-full" value="&lt;b&gt;At quota&lt;/b&gt;&lt;br&gt;Block new upload/generation only&lt;br&gt;Keep edit · export · download · delete available" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="sd-1"><mxGeometry x="1140" y="200" width="350" height="95" as="geometry"/></mxCell>

        <mxCell id="sd-counted" value="&lt;b&gt;Counts toward quota&lt;/b&gt;&lt;br&gt;Uploads · generated masters · copied Pexels assets&lt;br&gt;generated music · license attachments&lt;br&gt;Logical stored bytes owned by the account" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="sd-1"><mxGeometry x="80" y="370" width="430" height="120" as="geometry"/></mxCell>
        <mxCell id="sd-notcounted" value="&lt;b&gt;Does not count&lt;/b&gt;&lt;br&gt;Timeline/database metadata · worker temp files&lt;br&gt;Pexels search cache · expired previews/exports&lt;br&gt;Failed upload quarantine after cleanup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="sd-1"><mxGeometry x="585" y="370" width="430" height="120" as="geometry"/></mxCell>
        <mxCell id="sd-meter" value="&lt;b&gt;Quota admission&lt;/b&gt;&lt;br&gt;Warn at 80% and 95% · reserve expected bytes first&lt;br&gt;Reconcile actual bytes atomically after storage commit&lt;br&gt;Release reservations on failure/cancel; never delete to make room" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="sd-1"><mxGeometry x="1090" y="370" width="430" height="120" as="geometry"/></mxCell>

        <mxCell id="sd-active" value="Active draft" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="sd-1"><mxGeometry x="80" y="600" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="sd-trash" value="&lt;b&gt;Trash — 30 days&lt;/b&gt;&lt;br&gt;Launch default — configurable&lt;br&gt;Recoverable · counts toward quota · no new jobs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="sd-1"><mxGeometry x="350" y="575" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="sd-purge" value="&lt;b&gt;Permanent project purge&lt;/b&gt;&lt;br&gt;Delete only users/{userId}/projects/{projectId}/...&lt;br&gt;Format duplication copies the required media into its new prefix; quota charges each copy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="sd-1"><mxGeometry x="700" y="560" width="340" height="140" as="geometry"/></mxCell>
        <mxCell id="sd-refcount" value="&lt;b&gt;Project-owned assets&lt;/b&gt;&lt;br&gt;Account purge deletes the account prefix&lt;br&gt;&lt;i&gt;ponytail: duplicate bytes instead of sharing deletion lifetime.&lt;/i&gt;&lt;br&gt;Ceiling: extra R2 bytes; deduplicate only after measured cost justifies it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="sd-1"><mxGeometry x="1100" y="560" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="sd-freed" value="Quota released" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="sd-1"><mxGeometry x="1430" y="600" width="140" height="60" as="geometry"/></mxCell>

        <mxCell id="sd-revisions" value="&lt;b&gt;Revision recovery&lt;/b&gt;&lt;br&gt;Launch default — configurable: latest 50 revisions&lt;br&gt;Monotonic revision + optimistic concurrency; stale base_revision rejected&lt;br&gt;Preserve local commands; Reload latest or Save my version as a new project&lt;br&gt;Never overwrite silently or merge timelines automatically&lt;br&gt;&lt;i&gt;ponytail: single-writer optimistic locking; no branch/merge model. Ceiling: simultaneous edits save as copy; add structured merge only if telemetry proves conflicts common.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="sd-1"><mxGeometry x="50" y="745" width="490" height="190" as="geometry"/></mxCell>
        <mxCell id="sd-account" value="&lt;b&gt;Account deletion request&lt;/b&gt;&lt;br&gt;Recent reauthentication + explicit consequence summary&lt;br&gt;Mark deletion_pending · global sign-out · cancel queued work&lt;br&gt;Backend rejects old JWTs by checking account state&lt;br&gt;Launch default — configurable: 7-day recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="sd-1"><mxGeometry x="580" y="770" width="440" height="145" as="geometry"/></mxCell>
        <mxCell id="sd-erasure" value="&lt;b&gt;Irreversible erasure after day 7&lt;/b&gt;&lt;br&gt;Purge live media, credentials, prompts and profile data within 30 days&lt;br&gt;Then delete Supabase identity; encrypted backups age out by policy&lt;br&gt;Retain only minimized/pseudonymized tax, dispute, fraud and legal-claim records&lt;br&gt;Privacy/legal review sets jurisdiction-specific record periods" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="sd-1"><mxGeometry x="1090" y="760" width="440" height="165" as="geometry"/></mxCell>

        <mxCell id="sd-export" value="&lt;b&gt;Account data export before deletion&lt;/b&gt;&lt;br&gt;Async encrypted archive: project/timeline JSON · source assets · rights manifests · profile · credit/purchase history&lt;br&gt;Short-lived signed download URL · never include decrypted provider keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="sd-1"><mxGeometry x="300" y="980" width="1000" height="85" as="geometry"/></mxCell>

        <mxCell id="sd-e1" value="delete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="sd-1" source="sd-active" target="sd-trash"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sd-e2" value="restore" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="sd-1" source="sd-trash" target="sd-active"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sd-e3" value="day 30 / empty trash" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="sd-1" source="sd-trash" target="sd-purge"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sd-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="sd-1" source="sd-purge" target="sd-refcount"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sd-e5" value="prefix deleted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="sd-1" source="sd-refcount" target="sd-freed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sd-e6" value="after recovery window" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="sd-1" source="sd-account" target="sd-erasure"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="guided-editor" name="10. Guided Storyboard Editor">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="ge-0"/>
        <mxCell id="ge-1" parent="ge-0"/>
        <mxCell id="ge-title" value="Approved v1 Guided Storyboard Editor" style="text;html=1;fontSize=24;fontStyle=1;align=center;" vertex="1" parent="ge-1"><mxGeometry x="430" y="20" width="740" height="40" as="geometry"/></mxCell>
        <mxCell id="ge-principle" value="Creator-friendly scene editing, not a professional multitrack timeline. Every meaningful change is non-destructive, autosaved and recoverable." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="ge-1"><mxGeometry x="250" y="80" width="1100" height="60" as="geometry"/></mxCell>

        <mxCell id="ge-desktop" value="&lt;b&gt;Desktop / web / Linux layout&lt;/b&gt;&lt;br&gt;Left: ordered scene cards&lt;br&gt;Center: video preview&lt;br&gt;Right: selected-scene inspector&lt;br&gt;Footer: undo · save state · preview · export" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="ge-1"><mxGeometry x="80" y="200" width="420" height="135" as="geometry"/></mxCell>
        <mxCell id="ge-mobile" value="&lt;b&gt;Android / iOS layout&lt;/b&gt;&lt;br&gt;Full-width preview&lt;br&gt;Horizontal scene strip&lt;br&gt;Selected-scene bottom sheet&lt;br&gt;Persistent save state + top-bar preview/export" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="ge-1"><mxGeometry x="1080" y="200" width="420" height="135" as="geometry"/></mxCell>
        <mxCell id="ge-chat" value="&lt;b&gt;Chat remains available&lt;/b&gt;&lt;br&gt;Natural-language change request&lt;br&gt;→ proposed diff + cost&lt;br&gt;→ Apply / Cancel&lt;br&gt;Never mutate before confirmation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;" vertex="1" parent="ge-1"><mxGeometry x="610" y="190" width="380" height="145" as="geometry"/></mxCell>

        <mxCell id="ge-scene" value="&lt;b&gt;Scene controls&lt;/b&gt;&lt;br&gt;Reorder · duplicate · delete · replace media&lt;br&gt;Pexels search · upload · generate/regenerate selected scene&lt;br&gt;Trim · duration · crop/focal point · fit/fill&lt;br&gt;Lock scene against chat regeneration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="ge-1"><mxGeometry x="60" y="420" width="470" height="150" as="geometry"/></mxCell>
        <mxCell id="ge-text" value="&lt;b&gt;Text and captions&lt;/b&gt;&lt;br&gt;Headline · body · CTA · enable/disable&lt;br&gt;Position/alignment presets · theme typography&lt;br&gt;Small/medium/large · accessible colors · panel/shadow&lt;br&gt;Safe areas · script-derived captions + manual correction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="ge-1"><mxGeometry x="565" y="420" width="470" height="150" as="geometry"/></mxCell>
        <mxCell id="ge-motion" value="&lt;b&gt;Controlled motion&lt;/b&gt;&lt;br&gt;Transitions: cut · crossfade · slide · zoom · fade through black&lt;br&gt;Still motion: none · slow zoom in/out · pan left/right&lt;br&gt;No keyframes, masks, curves or custom effects" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="ge-1"><mxGeometry x="1070" y="420" width="470" height="150" as="geometry"/></mxCell>

        <mxCell id="ge-instant" value="&lt;b&gt;Storyboard preview&lt;/b&gt;&lt;br&gt;Selected scene frame/poster + text/crop/safe-area overlay&lt;br&gt;Approximate duration/order only&lt;br&gt;No transition, motion, or audio-sync rendering&lt;br&gt;&lt;i&gt;ponytail: storyboard feedback is intentionally not frame-accurate. Ceiling: editing guidance only. Upgrade only if measured users abandon edits because accurate-preview latency is unacceptable.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="ge-1"><mxGeometry x="90" y="625" width="430" height="165" as="geometry"/></mxCell>
        <mxCell id="ge-accurate" value="&lt;b&gt;Accurate preview — only render-equivalent representation&lt;/b&gt;&lt;br&gt;Explicit FFmpeg-rendered 720p watermarked server proxy&lt;br&gt;Required after material changes before export&lt;br&gt;Existing daily free/paid-preview policy applies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="ge-1"><mxGeometry x="600" y="640" width="400" height="135" as="geometry"/></mxCell>
        <mxCell id="ge-save" value="&lt;b&gt;Saving and conflicts&lt;/b&gt;&lt;br&gt;Undo/redo · command-batch autosave · visible status&lt;br&gt;Reject stale base_revision; preserve unsaved local commands&lt;br&gt;Offer Reload latest or Save my version as a new project&lt;br&gt;Never overwrite latest silently or merge timelines automatically&lt;br&gt;&lt;i&gt;ponytail: single-writer optimistic locking; no branch/merge model. Ceiling: simultaneous edits save as copy; structured merge only after conflict telemetry proves it common.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;" vertex="1" parent="ge-1"><mxGeometry x="1080" y="620" width="430" height="175" as="geometry"/></mxCell>

        <mxCell id="ge-format" value="&lt;b&gt;Format boundary&lt;/b&gt;&lt;br&gt;Lock 16:9 or 9:16 after concept selection. “Duplicate into another format” creates a new draft and adapts crop, timing and safe areas; the original stays untouched." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="ge-1"><mxGeometry x="70" y="850" width="460" height="110" as="geometry"/></mxCell>
        <mxCell id="ge-export" value="&lt;b&gt;Export readiness gate&lt;/b&gt;&lt;br&gt;Media available/not quarantined · duration valid · safe-area check&lt;br&gt;audio rights declaration · provider jobs complete · credits available&lt;br&gt;no billing restriction or unresolved edit conflict" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="ge-1"><mxGeometry x="570" y="850" width="460" height="110" as="geometry"/></mxCell>
        <mxCell id="ge-excluded" value="&lt;b&gt;Explicitly outside v1&lt;/b&gt;&lt;br&gt;Multitrack timeline · arbitrary layers · keyframes · masks/background-removal controls&lt;br&gt;color grading · plugins · collaboration/live cursors · custom transitions&lt;br&gt;advanced audio mixing · direct social publishing · in-place format conversion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="ge-1"><mxGeometry x="1070" y="835" width="470" height="140" as="geometry"/></mxCell>

        <mxCell id="ge-accessibility" value="&lt;b&gt;Validation gate:&lt;/b&gt; keyboard navigation on web/Linux · screen-reader labels · visible focus · touch targets · caption editing · contrast/safe-area checks · real Android/iOS/Linux hardware performance testing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="ge-1"><mxGeometry x="240" y="1020" width="1120" height="60" as="geometry"/></mxCell>

        <mxCell id="ge-e1" value="proposal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="ge-1" source="ge-chat" target="ge-scene"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="ge-1" source="ge-scene" target="ge-instant"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge-e3" value="request accurate render" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="ge-1" source="ge-instant" target="ge-accurate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge-e4" value="validated timeline" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="ge-1" source="ge-accurate" target="ge-export"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ponytail-mvp-gates" name="11. Ponytail MVP Gates">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="pg-0"/>
        <mxCell id="pg-1" parent="pg-0"/>
        <mxCell id="pg-title" value="Standalone F-Motion — Ponytail MVP Gates" style="text;html=1;fontSize=24;fontStyle=1;align=center;" vertex="1" parent="pg-1"><mxGeometry x="350" y="20" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="pg-rule" value="Passing a gate authorizes planning the next gate; it does not authorize deployment, paid provider calls, repository creation, or store submission." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="pg-1"><mxGeometry x="210" y="75" width="1180" height="60" as="geometry"/></mxCell>
        <mxCell id="pg-g0" value="&lt;b&gt;Gate 0 — provider/legal prerequisites&lt;/b&gt;&lt;br&gt;Beatoven/FAL written terms or provider agreement must confirm platform generation, end-user sublicensed synchronized commercial video use, private R2 storage, final YouTube/Reel/Story delivery, dispute provenance, and acceptable prompt/content data terms.&lt;br&gt;Confirm Pexels application use + attribution presentation. Payment, privacy, retention and takedown legal reviews remain launch gates.&lt;br&gt;&lt;i&gt;ponytail: no custom queue and no music integration on ambiguous rights.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="pg-1"><mxGeometry x="90" y="175" width="440" height="185" as="geometry"/></mxCell>
        <mxCell id="pg-g1" value="&lt;b&gt;Gate 1 — Flutter media feasibility spike&lt;/b&gt;&lt;br&gt;Throwaway fixtures; web + Android first. Prove playback/seek, scene switching, crop/focal point, text safe areas, audio playback/ducking approximation, signed R2 upload, local draft cache and responsive layout. Measure startup, interaction latency, memory and dropped frames on one ordinary Android device + desktop browser. Record pass/fail evidence. No production auth, billing, AI or FFmpeg." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="pg-1"><mxGeometry x="580" y="175" width="440" height="185" as="geometry"/></mxCell>
        <mxCell id="pg-g2" value="&lt;b&gt;Gate 2 — minimal vertical slice&lt;/b&gt;&lt;br&gt;Sign in → chat brief → three scene choices → Pexels media → scene reorder/text edit → server-rendered preview → download.&lt;br&gt;No managed FAL, payments, generated music, revision branching, iOS, or Linux packaging." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="pg-1"><mxGeometry x="1070" y="175" width="440" height="185" as="geometry"/></mxCell>
        <mxCell id="pg-g3" value="&lt;b&gt;Gate 3 — BYOK generation safety&lt;/b&gt;&lt;br&gt;Add FAL only after the vertical slice and legal/data-use evidence. Require owner-scoped server-side secrets, current provider-cost estimation, explicit confirmation, idempotency, and job isolation tests." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="pg-1"><mxGeometry x="90" y="455" width="440" height="145" as="geometry"/></mxCell>
        <mxCell id="pg-g4" value="&lt;b&gt;Gate 4 — platform expansion&lt;/b&gt;&lt;br&gt;Add iOS and Linux only after web/Android evidence meets the named performance and usability gates.&lt;br&gt;&lt;i&gt;ponytail: web + Android first; add iOS/Linux after measured media feasibility. Upgrade path: expand the same Flutter project when the gate passes.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="pg-1"><mxGeometry x="580" y="455" width="440" height="145" as="geometry"/></mxCell>
        <mxCell id="pg-g5" value="&lt;b&gt;Gate 5 — shared engine publication&lt;/b&gt;&lt;br&gt;Publish the existing standalone packages/reel-engine directory only when Fotium integration begins and two real consumers need identical domain behavior. Then add SemVer automation, private registry, independent pins, compatibility tests and draft-migration tests." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="pg-1"><mxGeometry x="1070" y="455" width="440" height="145" as="geometry"/></mxCell>
        <mxCell id="pg-policy" value="&lt;b&gt;Versioned server-side product policy/configuration&lt;/b&gt;&lt;br&gt;All numerical values are Launch default — configurable. Persist the applied policy version on purchase, generation, render and deletion events so later changes do not rewrite historical decisions.&lt;br&gt;Measure provider cost/project; generation/refund rates; render CPU by profile; R2 storage/delivery; previews before export; quota pressure by cohort; mobile fees/tax.&lt;br&gt;&lt;i&gt;ponytail: one versioned policy object; no rules engine. Ceiling: operator-managed releases. Upgrade path: admin policy UI only after changes become frequent.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="pg-1"><mxGeometry x="250" y="720" width="1100" height="160" as="geometry"/></mxCell>
        <mxCell id="pg-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pg-1" source="pg-g0" target="pg-g1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pg-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pg-1" source="pg-g1" target="pg-g2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pg-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pg-1" source="pg-g2" target="pg-g3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pg-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pg-1" source="pg-g3" target="pg-g4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pg-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="pg-1" source="pg-g4" target="pg-g5"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
