# Copy to `.env` for local self-hosting. Every value below is either a
# disposable local default or a placeholder. Replace it only with credentials
# for services you control; `.env` is gitignored and must never be committed.
SUPABASE_ISSUER=https://example.supabase.co/auth/v1
SUPABASE_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://example.supabase.co/auth/v1/.well-known/jwks.json
DATABASE_URL=postgresql://fengine:fengine@127.0.0.1:5432/fengine
QUEUE_DATABASE_URL=postgresql://fengine:fengine@127.0.0.1:5432/fengine
R2_ENDPOINT=http://127.0.0.1:9000
R2_BUCKET=fengine-local
R2_ACCESS_KEY_ID=fengine
R2_SECRET_ACCESS_KEY=fengine-local-secret
PEXELS_API_KEY=replace-me
API_ORIGIN=http://localhost:3000
# Local durable stack only — skips Supabase JWT. The API refuses to start
# with this set when NODE_ENV=production or FENGINE_ENV=hosted. Hosted
# deploys MUST leave this unset (or explicitly FENGINE_LOCAL_AUTH=0).
FENGINE_LOCAL_AUTH=1
# Local compatibility default. FENGINE_ENV=hosted refuses to start unless this
# is invite_only with exact Supabase Auth user UUIDs in protected configuration.
FENGINE_ACCESS_MODE=provision_verified
# FENGINE_ALLOWED_USER_IDS=11111111-1111-4111-8111-111111111111
# Web Vite proxy target for `npm run stack` (demo/e2e defaults to 43140).
VITE_API_PROXY=http://127.0.0.1:3000

# Web client Supabase config — required for real sign-in. Without these,
# the web client shows a demo sign-in that only works in `vite dev`
# (or with VITE_ALLOW_DEMO_AUTH=1, which hosted builds must never set).
# VITE_SUPABASE_URL=https://example.supabase.co
# VITE_SUPABASE_ANON_KEY=replace-with-public-browser-key
# Never put a Supabase service-role key in any VITE_* variable.
# Set only after the Google provider is configured in Supabase.
# VITE_ENABLE_GOOGLE_AUTH=1

# --- Durable self-host checklist (see docs/getting-started.md) ---
# - DATABASE_URL / QUEUE_DATABASE_URL: session-mode Postgres, not a
#   transaction-mode pooler (pg-boss needs stable connections — see
#   docs/decisions/queue.md).
# - R2_ENDPOINT / R2_REGION / R2_BUCKET / R2_ACCESS_KEY_ID /
#   R2_SECRET_ACCESS_KEY: point at the real private bucket, never the local
#   MinIO defaults above.
# - PEXELS_API_KEY: real value, set as a platform secret — never committed.
# - SUPABASE_ISSUER / SUPABASE_AUDIENCE / SUPABASE_JWKS_URL: the real
#   Supabase project, not example.supabase.co.
# - FENGINE_LOCAL_AUTH: leave unset (API refuses to boot with it set when
#   NODE_ENV=production or FENGINE_ENV=hosted).
# - FENGINE_ACCESS_MODE=invite_only and a non-empty FENGINE_ALLOWED_USER_IDS:
#   required for hosted startup. Never commit real user UUIDs.
# - VITE_ALLOW_DEMO_AUTH: leave unset on every hosted web build.
# - VITE_ENABLE_GOOGLE_AUTH: optional UI flag; setting it does not configure
#   the Google provider or its Supabase callback.
