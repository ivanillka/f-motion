SUPABASE_ISSUER=https://example.supabase.co/auth/v1
SUPABASE_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://example.supabase.co/auth/v1/.well-known/jwks.json
DATABASE_URL=postgresql://fmotion:fmotion@127.0.0.1:5432/fmotion
QUEUE_DATABASE_URL=postgresql://fmotion:fmotion@127.0.0.1:5432/fmotion
R2_ENDPOINT=http://127.0.0.1:9000
R2_BUCKET=fmotion-local
R2_ACCESS_KEY_ID=fmotion
R2_SECRET_ACCESS_KEY=fmotion-local-secret
PEXELS_API_KEY=replace-me
MEDIA_SIGNING_SECRET=replace-with-at-least-32-random-bytes
API_ORIGIN=http://localhost:3000
# Local durable stack only — skips Supabase JWT. The API refuses to start
# with this set when NODE_ENV=production or FMOTION_ENV=hosted. Hosted
# deploys MUST leave this unset (or explicitly FMOTION_LOCAL_AUTH=0).
FMOTION_LOCAL_AUTH=1
# Web Vite proxy target for `npm run stack` (demo/e2e defaults to 43140).
VITE_API_PROXY=http://127.0.0.1:3000

# Web client Supabase config — required for real sign-in. Without these,
# the web client shows a demo sign-in that only works in `vite dev`
# (or with VITE_ALLOW_DEMO_AUTH=1, which hosted builds must never set).
# VITE_SUPABASE_URL=https://example.supabase.co
# VITE_SUPABASE_ANON_KEY=replace-with-anon-key
