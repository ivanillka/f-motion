generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountState {
  active
  suspended
  deletion_pending
}

enum MediaState {
  admitted
  inspecting
  ready
  quarantined
  rejected
}

enum RenderState {
  queued
  running
  cancelled
  complete
  failed
}

enum RenderKind {
  preview
  final
}

model User {
  id                    String       @id
  state                 AccountState @default(active)
  acceptedPolicyVersion String?
  projects              Project[]
  media                  MediaAsset[]
  jobs                   RenderJob[]
  providerCredentials    ProviderCredential[]
  generationJobs         GenerationJob[]
  apiKeys                ApiKey[]
  usageBalance           UsageBalance?
  usageLedger            UsageLedger[]
}

model ApiKey {
  id         String    @id @default(uuid())
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tokenHash  String
  hint       String
  label      String    @default("default")
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([ownerId])
}

model UsageBalance {
  ownerId   String   @id
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
}

model UsageLedger {
  id             String   @id @default(uuid())
  ownerId        String
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  delta          Int
  reason         String
  idempotencyKey String
  createdAt      DateTime @default(now())

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId])
}

model ProviderCredential {
  id          String   @id @default(uuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  provider    String
  ciphertext  Bytes
  nonce       Bytes
  authTag     Bytes
  keyVersion  Int
  hint        String
  validatedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  generationJobs GenerationJob[]

  @@unique([ownerId, provider])
  @@index([ownerId])
}

model Project {
  id                String           @id @default(uuid())
  ownerId           String
  owner             User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  revision          Int              @default(0)
  brief             Json
  concepts          Concept[]
  scenes            Scene[]
  media             MediaAsset[]
  commands          CommandReceipt[]
  jobs              RenderJob[]
  generationJobs    GenerationJob[]

  @@unique([ownerId, id])
  @@index([ownerId])
}

model Concept {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  position  Int
  title     String
  treatment String
  selected  Boolean @default(false)

  @@unique([projectId, position])
}

model Scene {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  position  Int
  payload   Json

  @@unique([projectId, position])
}

model MediaAsset {
  id                  String     @id @default(uuid())
  ownerId             String
  owner               User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projectId           String
  project             Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quarantineObjectKey String
  sealedObjectKey     String?    @unique
  sealedEtag          String?
  sealedVersionId     String?
  sealedSha256        String?
  inspectionEtag      String?
  inspectionVersionId String?
  inspectionSha256    String?
  state               MediaState @default(admitted)
  declaredType        String
  maxBytes            Int
  detected            Json?
  attribution         Json?
  generationResults   GenerationJob[] @relation("GenerationResultMedia")
  generationSources   GenerationJob[] @relation("GenerationSourceMedia")

  @@unique([ownerId, projectId, id])
  @@unique([quarantineObjectKey])
}

model CommandReceipt {
  id          String   @id @default(uuid())
  ownerId     String
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commandId   String
  baseRevision Int
  result      Json

  @@unique([ownerId, projectId, commandId])
}

model RenderJob {
  id          String      @id @default(uuid())
  ownerId     String
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revision    Int
  kind        RenderKind @default(preview)
  renderProfile Json
  renderInput Json
  state       RenderState @default(queued)
  result      RenderResult?
  events      RenderEvent[]

  @@unique([ownerId, projectId, id])
}

model RenderEvent {
  id        BigInt    @id @default(autoincrement())
  jobId     String
  job       RenderJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  phase     String
  percent   Int
  createdAt DateTime  @default(now())

  @@index([jobId, id])
}

model RenderResult {
  id          String    @id @default(uuid())
  jobId       String    @unique
  job         RenderJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  objectKey   String    @unique
  metadata    Json
  createdAt   DateTime  @default(now())
}

/// Undispatched polling uses a partial createdAt index defined in SQL migration.
model WorkOutbox {
  id           String    @id @default(uuid())
  kind         String
  dedupeKey    String    @unique
  payload      Json
  createdAt    DateTime  @default(now())
  dispatchedAt DateTime?
}

enum GenerationKind {
  image
  image_to_video
  speech
}

enum GenerationState {
  quoted
  queued
  submitting
  running
  downloading
  inspecting
  ready
  cancelled
  failed
  submission_uncertain
}

/// Owner-scoped FAL generation outside the deterministic scene contract.
model GenerationJob {
  id                String          @id @default(uuid())
  ownerId           String
  owner             User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projectId         String
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneId           String
  credentialId      String?
  credential        ProviderCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  kind              GenerationKind  @default(image)
  sourceMediaId     String?
  sourceMedia       MediaAsset?     @relation("GenerationSourceMedia", fields: [sourceMediaId], references: [id], onDelete: SetNull)
  endpointId        String
  prompt            String
  inputJson         Json
  quoteJson         Json
  quoteExpiresAt    DateTime
  state             GenerationState @default(quoted)
  cancelRequested   Boolean         @default(false)
  providerRequestId String?
  resultMediaId     String?
  resultMedia       MediaAsset?     @relation("GenerationResultMedia", fields: [resultMediaId], references: [id], onDelete: SetNull)
  failureCode       String?
  idempotencyKey    String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([ownerId, projectId, idempotencyKey])
  @@index([ownerId, projectId, sceneId])
  @@index([ownerId, state])
  @@index([state, updatedAt])
}
