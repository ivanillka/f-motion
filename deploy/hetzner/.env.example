# f-motion.com on Hetzner. Copy to deploy/hetzner/.env — never commit values.
# This is invite-only hosted mode, not the open-source single-seat VPS path.

FENGINE_ENV=hosted
FENGINE_ACCESS_MODE=invite_only
# Comma-separated Supabase Auth user UUIDs. Never commit real IDs.
FENGINE_ALLOWED_USER_IDS=11111111-1111-4111-8111-111111111111

# Public origins. Cloudflare can orange-cloud both names to this VPS :80.
FENGINE_WEB_ORIGIN=https://f-motion.com
WEB_PUBLISH_PORT=80

# Existing hosted Postgres (session-mode, not a transaction pooler).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
QUEUE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
PGSSLMODE=verify-full

# Existing private object storage (R2 or S3-compatible).
R2_ENDPOINT=https://YOUR_ACCOUNT.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=fengine
R2_ACCESS_KEY_ID=replace-with-access-key
R2_SECRET_ACCESS_KEY=replace-with-secret-key
R2_PUBLIC_ENDPOINT=https://media.example.com

# F-Motion Supabase Auth (browser keys are public; still do not commit them).
SUPABASE_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
SUPABASE_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-public-anon-key
# VITE_ENABLE_GOOGLE_AUTH=1

# BYOK providers (users paste keys in Settings). Generate the KEK once.
FENGINE_PEXELS_BYOK_ENABLED=1
FENGINE_FAL_BYOK_ENABLED=0
FENGINE_CREDENTIAL_ACTIVE_KEY_VERSION=1
FENGINE_CREDENTIAL_KEY_V1=replace-with-openssl-rand-base64-32

PREVIEW_RENDER_WIDTH=540
PREVIEW_RENDER_HEIGHT=960
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
OUTBOX_RETENTION_HOURS=168
FENGINE_FREE_RENDER_UNITS=25

# Leave these unset:
# FENGINE_LOCAL_AUTH=1
# VITE_ALLOW_DEMO_AUTH=1
# PEXELS_API_KEY= / FAL_KEY=   # shared keys are rejected at startup
