# One-box VPS install for open-source F-Motion (single seat).
# Copy to deploy/vps/.env and fill in Supabase + YOUR one user UUID.
# Multi-user / team seats are the paid corporate product — not this path.
# This path is intentionally NOT Fly.io and NOT Fotium.

# --- Open-source single-seat marker ---
FENGINE_ENV=selfhost
FENGINE_ACCESS_MODE=single_user
# Exactly one Supabase Auth user UUID. A second ID will refuse to start.
FENGINE_ALLOWED_USER_IDS=11111111-1111-4111-8111-111111111111

# --- Public host the browser uses ---
# Web UI (nginx) and signed MinIO URLs must be reachable from the browser.
# This VPS already publishes the studio on :8090.
FENGINE_WEB_ORIGIN=http://127.0.0.1:8090
R2_PUBLIC_ENDPOINT=http://127.0.0.1:9000
WEB_PUBLISH_PORT=8090
MINIO_PUBLISH_PORT=9000

# --- Postgres / MinIO (compose defaults; change passwords on a real VPS) ---
POSTGRES_PASSWORD=fengine
MINIO_ROOT_USER=fengine
MINIO_ROOT_PASSWORD=fengine-local-secret
R2_BUCKET=fengine

# --- Supabase Auth (required; create a free project you control) ---
SUPABASE_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
SUPABASE_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-public-anon-key
# Optional Google button (also enable the provider in Supabase).
# VITE_ENABLE_GOOGLE_AUTH=1

# --- BYOK providers (the single seat pastes their own keys in Settings) ---
FENGINE_PEXELS_BYOK_ENABLED=1
FENGINE_FAL_BYOK_ENABLED=1
FENGINE_CREDENTIAL_ACTIVE_KEY_VERSION=1
# Generate once: openssl rand -base64 32
FENGINE_CREDENTIAL_KEY_V1=replace-with-openssl-rand-base64-32

# --- Host render metering (F-Motion units only; not FAL/Pexels spend) ---
FENGINE_FREE_RENDER_UNITS=25
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
PREVIEW_RENDER_WIDTH=540
PREVIEW_RENDER_HEIGHT=960

# --- Explicitly leave unset on this open-source VPS path ---
# FENGINE_ENV=hosted          # Fly/private multi-invite hosted mode only
# FENGINE_ACCESS_MODE=invite_only  # multi-seat / corporate — paid product
# FENGINE_LOCAL_AUTH=1        # forbidden in production images
# VITE_ALLOW_DEMO_AUTH=1      # never for a durable host
# VITE_PARTNER_BRAND_EMAIL=   # Fotium partner chrome — omit entirely
# FENGINE_IMPORT_TOKEN=       # Fotium trusted import — omit entirely
# SUPABASE_ISSUER_EXTRA=      # Fotium JWT handoff — omit entirely
# PEXELS_API_KEY= / FAL_KEY=  # shared keys are rejected at startup
